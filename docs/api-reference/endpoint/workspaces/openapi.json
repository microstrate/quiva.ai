      "ApproveApprovalRequest": {
        "type": "object",
        "description": "Payload to approve a file approval.",
        "properties": {
          "feedback": {
            "type": "string",
            "description": "Free-text feedback left by the signatory, typically on rejection.",
            "example": "Please correct the payment terms in section 3."
          },
          "metadata": {
            "$ref": "#/components/schemas/FileApprovalEventMetadata",
            "description": "Audit metadata captured for the approval action."
          }
        }
      },
      "RejectApprovalRequest": {
        "type": "object",
