            "example": "Please correct the payment terms in section 3."
          },
          "metadata": {
            "$ref": "#/components/schemas/FileApprovalEventMetadata",
            "description": "Audit metadata captured for the approval action."
          }
        }
      },
      "ApprovalEvent": {
        "type": "object",
        "description": "An event emitted when a file approval changes state.",
        "required": [
          "metadata",
          "event_type"
        ],
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/FileApprovalEventMetadata",
            "description": "Audit metadata associated with the event."
          },
          "event_type": {
            "type": "string",
            "description": "Type of the approval event.",
            "example": "approval.approved"
          },
          "feedback": {
            "type": "string",
            "description": "Free-text feedback left by the signatory, typically on rejection.",
            "example": "Please correct the payment terms in section 3."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the event record was captured.",
            "example": "2026-07-07T14:32:10Z"
          }
        }
      },
      "ApprovalEventList": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprovalEvent"
            }
          },
          "results_total": {
            "type": "integer"
          }
        }
      }
